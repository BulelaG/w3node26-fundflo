# FundFlow Server Environment Configuration Template
# Duplicate this file to .env and fill in values (NEVER commit .env to Git)

PORT=5000
NODE_ENV=development

# XRPL Testnet WebSocket Node
XRPL_NODE_URL=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER_URL=https://testnet.xrpl.org

# Admin/Sponsor Testnet Wallet Seed (treasury that signs every disbursement)
# STRONGLY RECOMMENDED for demos: pre-fund this wallet at https://faucet.altnet.rippletest.net
# If empty, a throwaway faucet wallet is generated on boot (new treasury on every restart, faucet rate limits apply).
# There is intentionally NO hardcoded fallback seed in the source code.
XRPL_ADMIN_SEED=

# Indicative XRP -> ZAR conversion used by analytics (served to the client via GET /api/config)
# Default 165 (10 XRP stipend ~ R1,650)
XRP_TO_ZAR_RATE=165

# Database Connection (MongoDB URI)
# If left empty, FundFlow falls back to the embedded in-memory memory store for immediate local zero-config runs
MONGO_URI=
