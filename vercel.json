{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fundflow-api-a9te.onrender.com/api/:path*"
    },
    {
      "source": "/api",
      "destination": "https://fundflow-api-a9te.onrender.com/api"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
